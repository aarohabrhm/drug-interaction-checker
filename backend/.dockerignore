# Keep secrets, local state and build noise out of the image.
# Anything not needed at runtime also means a smaller, faster build.

.env
.env.*
!.env.example
*.pem
*.key

__pycache__/
*.py[cod]
env1/
venv/
.venv/
.auditvenv/

db.sqlite3
*.sqlite3
*.db
db_drug_interactions.csv

staticfiles/
.pytest_cache/
.coverage
htmlcov/

node_modules/
.git/
.gitignore
Dockerfile
.dockerignore
README.md
*.log
