# SafeMeds backend environment.
# Copy to `backend/.env` and fill in real values. NEVER commit the filled-in file.
#
# Variables marked REQUIRED have no default -- the app refuses to start without
# them (see backend/settings.py). This is deliberate: a medical app must not
# silently boot with an insecure fallback.

# ---------------------------------------------------------------- core (REQUIRED)
# REQUIRED. Generate a fresh one, never reuse a 'django-insecure-' key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# REQUIRED in production. "true" only on a developer machine.
DJANGO_DEBUG=false

# REQUIRED when DJANGO_DEBUG=false. Comma-separated hostnames, no scheme.
DJANGO_ALLOWED_HOSTS=safemeds.example.com

# Comma-separated absolute origins (with scheme) trusted for POST/CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://safemeds.example.com

# ------------------------------------------------------------ database (REQUIRED)
# REQUIRED. Full connection URL -- replaces the old hardcoded credentials.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/drug_checker

# Seconds to keep a pooled connection alive. 0 disables pooling (a new
# connection per request). 60 is a sane default behind a normal load balancer.
DATABASE_CONN_MAX_AGE=60

# Fail fast instead of hanging when Postgres is unreachable.
DATABASE_CONNECT_TIMEOUT=5

# --------------------------------------------------------------------- CORS
# Comma-separated absolute origins allowed to call the API from a browser.
# Must NOT be "*" -- this API serves authenticated patient data.
CORS_ALLOWED_ORIGINS=https://safemeds.example.com

# ------------------------------------------------------------------- Gemini
# Interaction-lookup fallback. If unset, the API still works but only answers
# from the local database (no external lookups) -- it degrades, not crashes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=10

# -------------------------------------------------------------------- auth
# Auth tokens expire after this many hours. DRF's default tokens never
# expire; SafeMeds enforces a TTL on top.
AUTH_TOKEN_TTL_HOURS=12

# ------------------------------------------------------------------ limits
# Caps to keep a single request from fanning out into an unbounded number of
# drug-pair lookups and external API calls.
MAX_NEW_MEDICATIONS=25
MAX_CURRENT_MEDICATIONS=50

# ----------------------------------------------------------------- logging
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------- HTTPS
# Leave true in production. Set false only for local HTTP development.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
