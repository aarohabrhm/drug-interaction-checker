# SafeMeds frontend environment.
# Copy to `project/.env` for local dev. Set these in your host's build config
# for production.
#
# WARNING: everything prefixed VITE_ is inlined into the JavaScript bundle and
# is therefore PUBLIC. Never put an API key, token or secret here.

# REQUIRED for production builds -- `npm run build` fails without it.
# Origin of the Django API, no trailing slash.
VITE_API_BASE_URL=https://api.safemeds.example.com
