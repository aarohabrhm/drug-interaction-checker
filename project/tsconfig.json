{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    // Duplicated from tsconfig.app.json because tooling reads the root config
    // rather than the referenced project -- the shadcn CLI resolves its output
    // paths from here, and writes to a literal "@" folder without it.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // Ensure TypeScript can resolve modules correctly
    "moduleResolution": "node",
    // Enable strict type checking for better error detection
    "strict": true,
    // Skip type checking of declaration files for faster compilation
    "skipLibCheck": true,
    // Ensure compatibility with Next.js
    "esModuleInterop": true,
    "allowJs": true,
    "isolatedModules": true
  }
}